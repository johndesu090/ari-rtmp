# ── Ari RTMP edge — Docker environment (copy to .env.edge) ─────────────

# Public base URL of the origin.
ORIGIN_URL=https://stream.example.com

# Public base URL of THIS edge (used for registration + cache origin).
EDGE_URL=https://edge1.example.com

EDGE_NAME=edge1
EDGE_REGION=us-east

# Paste from the dashboard: Edge Servers → Generate / rotate.
EDGE_REGISTRATION_TOKEN=

# Set to enable SSL when a matching certificate exists in the edge cert volume.
# EDGE_SERVER_NAME=edge1.example.com
