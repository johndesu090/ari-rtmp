# ── Ari RTMP origin — Docker environment (copy to .env) ────────────────
# deploy.sh generates secrets for you; edit as needed.

# Public URL users/players hit. HTTP: http://<server-ip>  HTTPS: https://<domain>
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

# Nginx server_name. "_" for IP mode, or your domain when using SSL.
SERVER_NAME=_
# Domain used for the Let's Encrypt certificate (leave blank for IP mode).
DOMAIN=

# Database
DB_USER=ari_rtmp
DB_NAME=ari_rtmp
DB_PASSWORD=change-me

# Secrets (deploy.sh fills these with random values)
JWT_SECRET=change-me
SESSION_SECRET=change-me
INTERNAL_API_TOKEN=change-me

# Tokens
TOKEN_TTL_SECONDS=60
ADMIN_SESSION_HOURS=24

# P2P segment sharing
P2P_ENABLED=true
P2P_MAX_PEERS=5
P2P_MAX_SWARM_PEERS=200
P2P_SNAPSHOT_SECONDS=30
P2P_ICE_SERVERS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
