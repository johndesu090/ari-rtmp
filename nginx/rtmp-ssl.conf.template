# ── Ari RTMP — RTMP ingest (SSL / domain mode) ─────────────────────────
# Rendered by install.sh into /usr/local/nginx/conf/rtmp.conf
# Placeholders: __APP_UPSTREAM__ __HLS_ROOT__ __TRANSCODE_SCRIPT__
#               __SERVER_NAME__ __SSL_CERT__ __SSL_KEY__

rtmp {
    server {
        listen 1935;
        chunk_size 4096;
        max_message 8M;
        ping 30s;
        ping_timeout 30s;

        application live {
            live on;
            record off;
            meta copy;

            allow publish all;
            allow play all;

            on_publish      http://__APP_UPSTREAM__/api/rtmp/on_publish;
            on_publish_done http://__APP_UPSTREAM__/api/rtmp/on_publish_done;

            exec_kill_signal term;
            exec __TRANSCODE_SCRIPT__ $name;
        }
    }

    # ── RTMPS (TLS ingest) on port 1936 ────────────────────────────────
    server {
        listen 1936 ssl;
        chunk_size 4096;
        max_message 8M;

        ssl_certificate     __SSL_CERT__;
        ssl_certificate_key __SSL_KEY__;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        application live {
            live on;
            record off;
            meta copy;

            allow publish all;
            allow play all;

            on_publish      http://__APP_UPSTREAM__/api/rtmp/on_publish;
            on_publish_done http://__APP_UPSTREAM__/api/rtmp/on_publish_done;

            exec_kill_signal term;
            exec __TRANSCODE_SCRIPT__ $name;
        }
    }
}
