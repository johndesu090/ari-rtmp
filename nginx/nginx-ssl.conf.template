# ── Ari RTMP — Nginx (HTTPS / domain mode) ─────────────────────────────
# Rendered by install.sh into /usr/local/nginx/conf/nginx.conf
# Placeholders: __APP_UPSTREAM__ __HLS_ROOT__ __SERVER_NAME__ __INTERNAL_TOKEN__
#               __SSL_CERT__ __SSL_KEY__

user  www-data;
worker_processes  auto;
pid  /run/nginx.pid;
error_log  /var/log/nginx/error.log warn;

events {
    worker_connections  4096;
    multi_accept on;
}

# RTMP + RTMPS ingest + transcoder spawn (see rtmp.conf).
include /usr/local/nginx/conf/rtmp.conf;

http {
    include       mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    server_tokens   off;
    client_max_body_size 8m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # auth_request subrequests inherit $request_uri but NOT $args, so the
    # playback token is extracted from the original URI and forwarded as a
    # header (a bare `proxy_pass ...$is_args$args` would send no token).
    map $request_uri $ari_play_token {
        default "";
        ~token=([^&]+) $1;
    }

    # ── Proxy-aware HTTPS redirect ─────────────────────────────────────
    # A front proxy (e.g. Cloudflare in "Flexible" mode) may terminate TLS
    # and forward to us over plain HTTP while the client actually used HTTPS.
    # In that case we must NOT redirect to HTTPS or the proxy loops forever.
    # We trust X-Forwarded-Proto and Cloudflare's CF-Visitor to tell us.
    map $http_x_forwarded_proto $ari_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }
    map "$ari_proto|$http_cf_visitor" $ari_client_https {
        default 0;
        "~*https" 1;
    }
    # ACME HTTP-01 challenges must never be redirected.
    map $request_uri $ari_is_acme {
        default 0;
        "~^/\.well-known/acme-challenge/" 1;
    }
    # Redirect only when: plain HTTP AND client was not already on HTTPS AND
    # this is not an ACME challenge.
    map "$scheme|$ari_client_https|$ari_is_acme" $ari_force_https_redirect {
        default 0;
        "http|0|0" 1;
    }

    # Shared SSL settings.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/vnd.apple.mpegurl;

    # ── HTTP + HTTPS ───────────────────────────────────────────────────
    server {
        listen 80;
        listen [::]:80;
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name __SERVER_NAME__;

        ssl_certificate     __SSL_CERT__;
        ssl_certificate_key __SSL_KEY__;

        # Plain HTTP (not behind a TLS-terminating proxy) → redirect to HTTPS.
        if ($ari_force_https_redirect = 1) {
            return 301 https://$host$request_uri;
        }

        # ACME HTTP-01 challenge webroot (used by Certbot renewal).
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # ── HLS delivery (token-gated) ─────────────────────────────────
        location /hls/ {
            alias __HLS_ROOT__/;
            auth_request /_hls_auth;

            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }

            add_header Cache-Control "no-cache" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Origin, Accept" always;
            add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;

            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin "*";
                add_header Access-Control-Allow-Methods "GET, OPTIONS";
                add_header Access-Control-Allow-Headers "Range, Origin, Accept";
                return 204;
            }
        }

        # Internal auth subrequest → backend token verification.
        location = /_hls_auth {
            internal;
            proxy_pass http://__APP_UPSTREAM__/api/playback/verify$is_args$args;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Internal-Token __INTERNAL_TOKEN__;
            proxy_set_header X-Play-Token $ari_play_token;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header True-Client-IP $http_true_client_ip;
            proxy_set_header User-Agent $http_user_agent;
        }

        # ── P2P signaling (WebSocket) ──────────────────────────────────
        location /p2p {
            proxy_pass http://__APP_UPSTREAM__;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $ari_proto;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        location / {
            proxy_pass http://__APP_UPSTREAM__;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $ari_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}

# ── RTMPS (TLS ingest) on port 1936 ────────────────────────────────────
# nginx-rtmp has no `listen ssl`, so TLS is terminated by the stream module
# and the decrypted RTMP is proxied to the plain ingest port 1935.
stream {
    upstream rtmp_ingest {
        server 127.0.0.1:1935;
    }

    server {
        listen 1936 ssl;
        listen [::]:1936 ssl;

        proxy_pass rtmp_ingest;
        proxy_connect_timeout 5s;
        proxy_timeout 10m;

        ssl_certificate     __SSL_CERT__;
        ssl_certificate_key __SSL_KEY__;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
    }
}
