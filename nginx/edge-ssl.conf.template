# ── Ari RTMP — Edge / sub-server (HTTPS) ───────────────────────────────
# Rendered by install-edge.sh into /etc/nginx/sites-available/ari-edge.
# Placeholders: __EDGE_SERVER_NAME__ __ORIGIN_URL__ __ORIGIN_HOST__
#               __SSL_CERT__ __SSL_KEY__

map $uri $ari_is_playlist {
    ~\.m3u8$ 1;
    default  0;
}

# auth_request subrequests inherit $request_uri but NOT $args, so the playback
# token is extracted from the original URI and forwarded as a header.
map $request_uri $ari_play_token {
    default "";
    ~token=([^&]+) $1;
}

# A front proxy (e.g. Cloudflare "Flexible") may terminate TLS and forward to
# us over plain HTTP while the client used HTTPS. Never redirect in that case.
map $http_x_forwarded_proto $ari_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
map "$ari_proto|$http_cf_visitor" $ari_client_https {
    default 0;
    "~*https" 1;
}
map $request_uri $ari_is_acme {
    default 0;
    "~^/\.well-known/acme-challenge/" 1;
}
map "$scheme|$ari_client_https|$ari_is_acme" $ari_force_https_redirect {
    default 0;
    "http|0|0" 1;
}

proxy_cache_path /var/cache/nginx/ari levels=1:2 keys_zone=ari_hls:20m
                 max_size=20g inactive=5m use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    # Ubuntu's distro nginx (< 1.25.1) does not support the `http2 on;`
    # directive, so enable HTTP/2 on the listen line instead.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __EDGE_SERVER_NAME__;
    server_tokens off;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Plain HTTP (not behind a TLS-terminating proxy) → redirect to HTTPS.
    if ($ari_force_https_redirect = 1) {
        return 301 https://$host$request_uri;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /edge/health {
        default_type text/plain;
        return 200 "ok";
    }

    location /hls/ {
        auth_request /_edge_auth;

        proxy_pass __ORIGIN_URL__/hls/;
        proxy_http_version 1.1;
        proxy_set_header Host __ORIGIN_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;

        proxy_cache ari_hls;
        proxy_cache_key "$host$uri";
        proxy_cache_valid 200 10s;
        proxy_cache_valid 404 1s;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_no_cache $ari_is_playlist;
        proxy_cache_bypass $ari_is_playlist;
        add_header X-Cache-Status $upstream_cache_status always;

        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Range, Origin, Accept" always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;
        add_header Cache-Control "no-cache" always;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, OPTIONS";
            add_header Access-Control-Allow-Headers "Range, Origin, Accept";
            return 204;
        }
    }

    location = /_edge_auth {
        internal;
        proxy_pass __ORIGIN_URL__/api/playback/verify-edge$is_args$args;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host __ORIGIN_HOST__;
        proxy_ssl_server_name on;
        proxy_set_header X-Play-Token $ari_play_token;
    }

    location / {
        return 404;
    }
}
