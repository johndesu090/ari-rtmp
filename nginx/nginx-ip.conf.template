# ── Ari RTMP — Nginx (HTTP / IP mode) ──────────────────────────────────
# Rendered by install.sh into /usr/local/nginx/conf/nginx.conf
# Placeholders: __APP_UPSTREAM__ __HLS_ROOT__ __SERVER_NAME__ __INTERNAL_TOKEN__

user  www-data;
worker_processes  auto;
pid  /run/nginx.pid;
error_log  /var/log/nginx/error.log warn;

events {
    worker_connections  4096;
    multi_accept on;
}

# RTMP ingest + transcoder spawn (see rtmp.conf).
include /usr/local/nginx/conf/rtmp.conf;

http {
    include       mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    server_tokens   off;
    client_max_body_size 8m;

    # WebSocket / SSE upgrade support for the API proxy.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # auth_request subrequests inherit $request_uri but NOT $args, so the
    # playback token is extracted from the original URI and forwarded as a
    # header (a bare `proxy_pass ...$is_args$args` would send no token).
    map $request_uri $ari_play_token {
        default "";
        ~token=([^&]+) $1;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/vnd.apple.mpegurl;

    server {
        listen 80;
        listen [::]:80;
        server_name __SERVER_NAME__;

        # ACME HTTP-01 challenge webroot (used by Certbot renewal).
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # ── HLS delivery (token-gated) ─────────────────────────────────
        location /hls/ {
            alias __HLS_ROOT__/;
            auth_request /_hls_auth;

            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }

            add_header Cache-Control "no-cache" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Origin, Accept" always;
            add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;

            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin "*";
                add_header Access-Control-Allow-Methods "GET, OPTIONS";
                add_header Access-Control-Allow-Headers "Range, Origin, Accept";
                return 204;
            }
        }

        # Internal auth subrequest → backend token verification.
        location = /_hls_auth {
            internal;
            proxy_pass http://__APP_UPSTREAM__/api/playback/verify$is_args$args;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Internal-Token __INTERNAL_TOKEN__;
            proxy_set_header X-Play-Token $ari_play_token;
        }

        # ── P2P signaling (WebSocket) ──────────────────────────────────
        location /p2p {
            proxy_pass http://__APP_UPSTREAM__;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # ── API + frontend (proxied to Node) ───────────────────────────
        location / {
            proxy_pass http://__APP_UPSTREAM__;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
