# ── Ari RTMP environment ───────────────────────────────────────────────
# Copy to .env and edit. install.sh writes this file for you.

NODE_ENV=production

# HTTP/API listen address (nginx reverse-proxies to this)
PORT=3000
HOST=127.0.0.1

# Public base URL of the deployment (no trailing slash).
# HTTPS example: https://stream.example.com
# IP example:    http://203.0.113.10
PUBLIC_BASE_URL=http://localhost

# Host advertised for RTMP/RTMPS ingest. Leave empty to use PUBLIC_BASE_URL's
# host. Set this when the public hostname is behind a proxy/CDN that does not
# forward ports 1935/1936 (e.g. a Cloudflare-proxied domain) — point it at a
# DNS-only ("grey cloud") hostname or the origin IP.
#   INGEST_HOST=stream.example.com
#   INGEST_HOST=203.0.113.10
INGEST_HOST=

# ── Secrets ────────────────────────────────────────────────────────────
# Long random strings. install.sh generates these with openssl.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ari_rtmp:CHANGE_ME@127.0.0.1:5432/ari_rtmp?schema=public

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Tokens ─────────────────────────────────────────────────────────────
# Playback token lifetime in seconds (short-lived, auto-refreshed by player).
TOKEN_TTL_SECONDS=30
# Admin dashboard session lifetime in hours.
ADMIN_SESSION_HOURS=24

# ── Media paths ────────────────────────────────────────────────────────
# Where ffmpeg writes HLS output (must match nginx template + install.sh).
HLS_ROOT=/var/www/hls
# Internal RTMP origin used by the transcoder (nginx-rtmp listens here).
RTMP_INGEST_URL=rtmp://127.0.0.1:1935/live

# ── Peer-to-peer segment sharing (SwarmCloud-style P2P-CDN) ─────────────
# Viewers exchange HLS segments over WebRTC to cut origin bandwidth.
P2P_ENABLED=true
# WebRTC neighbours each peer connects to.
P2P_MAX_PEERS=5
# Max peers allowed in a single stream swarm.
P2P_MAX_SWARM_PEERS=200
# Seconds between dashboard telemetry snapshots.
P2P_SNAPSHOT_SECONDS=30
# ICE servers. Either a JSON array or a comma-separated list.
# A TURN server is recommended for viewers behind strict NAT.
# P2P_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]
P2P_ICE_SERVERS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
